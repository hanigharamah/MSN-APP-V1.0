# =============================================================================
# MSN app — environment
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# EXPO_PUBLIC_* variables are INLINED INTO THE JS BUNDLE at build time. Anyone
# who downloads the app can read them. Only ever put values here that are safe
# to publish:
#
#   SAFE   — Supabase project URL, Supabase *anon* key (RLS is the real guard),
#            Stripe *publishable* key, bundle ids.
#   NEVER  — Supabase service-role key, Stripe secret key, Apple/Google API
#            credentials, webhook signing secrets. Those live in Supabase Edge
#            Function secrets (`supabase secrets set ...`) and never reach the
#            client.
# -----------------------------------------------------------------------------

# --- Supabase ----------------------------------------------------------------
# Project settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Stripe ------------------------------------------------------------------
# Publishable key only. pk_test_... in dev, pk_live_... in production.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Apple Pay merchant identifier. Leave blank until Apple Pay is enabled.
EXPO_PUBLIC_APPLE_MERCHANT_ID=

# --- App identity ------------------------------------------------------------
EXPO_PUBLIC_BUNDLE_ID=network.mysource.app

# --- Build (not inlined into the bundle; read by app.config.ts at build time) -
EAS_PROJECT_ID=
