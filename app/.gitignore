# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build output (managed workflow — these are generated by prebuild)
/ios
# /android is deliberately NOT ignored — see the note in the repo-root
# .gitignore. It is 264 KB of source, Expo's own android/.gitignore keeps the
# build output and local SDK path out, and committing it means a Windows
# developer can clone and run without prebuilding first.
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Environment — never commit real keys. .env.example is the committed template.
.env
.env.local
.env.*.local

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Editors
.idea/
*.swp

# Typescript
*.tsbuildinfo
